# Copy to .env for local development: cp .env.example .env
# Values below match docker-compose.yml and are for local use only.
# Real values for staging and production live in the hosting provider's
# environment settings, never in this repo.

# --- Database -------------------------------------------------------------
# Postgres connection string. Local: the `postgres` service in docker-compose.
# Staging/production: Neon, EU region (D-111). On Vercel the Neon integration
# sets the pooled URL (host ends in -pooler); prepared statements are then off.
DATABASE_URL=postgres://kasa:kasa@localhost:5432/kasa
# Direct (unpooled) connection for migrations; set by the Neon integration on
# Vercel. Leave empty locally, where DATABASE_URL is already direct. The
# realtime service and worker use a direct URL as their DATABASE_URL (F-10).
DATABASE_URL_UNPOOLED=
# Vercel only: 1 runs migrations during that environment's build (F-09).
# Set it for Production; for Preview only while previews get their own Neon
# branch, so an unmerged migration never reaches the staging database.
# MIGRATE_ON_BUILD=1

# --- Object storage (screenshots, photos, drawings) ------------------------
# Any S3-compatible endpoint. Local: the SeaweedFS `s3` service.
# Staging/production: the EU bucket chosen in F-03 (D-111).
S3_ENDPOINT=http://localhost:8333
# Region name sent with requests. R2 uses "auto"; SeaweedFS accepts anything.
S3_REGION=us-east-1
# Bucket holding all media. Private; objects are served via signed URLs (F-06).
S3_BUCKET=kasa-media
# Access key pair for the bucket. Local values come from infra/seaweedfs/s3.json.
S3_ACCESS_KEY_ID=kasa-dev
S3_SECRET_ACCESS_KEY=kasa-dev-secret
# true for SeaweedFS/MinIO-style path URLs (http://host/bucket/key); false for AWS.
S3_FORCE_PATH_STYLE=true

# --- Auth (Better Auth, D-127) ----------------------------------------------
# Signs session cookies and tokens. Any long random string; generate one with
# `openssl rand -base64 32`. The value below is for local use only.
BETTER_AUTH_SECRET=local-dev-secret-change-me-0123456789abcdef
# Public URL of the web app, used for OAuth callbacks.
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# Leave empty to run without Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Realtime (apps/realtime, P-06, D-157) ---------------------------------
# Shared by the web app (signs tickets) and the realtime service (checks them).
# Any long random string, e.g. `openssl rand -hex 32`. Without it and
# REALTIME_PUBLIC_URL the feed works without live updates.
REALTIME_SECRET=
# The WebSocket URL browsers connect to (web app).
REALTIME_PUBLIC_URL=ws://localhost:3200
# Port the realtime service listens on (default 3200).
REALTIME_PORT=3200
# Comma-separated origins allowed to connect (realtime service). Defaults to
# BETTER_AUTH_URL.
REALTIME_ALLOWED_ORIGINS=http://localhost:3000

# --- Link unfurling (worker, P-05) ------------------------------------------
# Tests only: set to 1 so the worker unfurls only from 127.0.0.1/::1 and never
# reaches the internet. The worker refuses to start with it when NODE_ENV=production.
# UNFURL_LOOPBACK_ONLY=1

# --- Email (Resend, P-12, D-163) --------------------------------------------
# Resend API key (resend.com > API Keys, "Sending access" only). Leave empty to
# send nothing: the worker logs a line instead, so local runs and tests work.
RESEND_API_KEY=
# Sender, on a domain verified in Resend (D-167), e.g. Kasa <notifications@example.com>.
# Required when RESEND_API_KEY is set.
EMAIL_FROM=
# Signs unsubscribe links (worker) and checks them (web app). Any long random
# string, e.g. `openssl rand -hex 32`; changing it breaks links in sent emails.
# Required when RESEND_API_KEY is set.
UNSUBSCRIBE_SECRET=
# Tests only: point the worker at a fake Resend server.
# RESEND_BASE_URL=http://127.0.0.1:3202

# --- Pilot (P-13) --------------------------------------------------------------
# Where the worker emails each "Send feedback" message (D-181), e.g. your own
# address. Leave empty to only store them; they're listed at /feedback either way.
FEEDBACK_EMAIL=
# Comma-separated emails of the people who can open /feedback. Empty: nobody.
PILOT_ADMIN_EMAILS=
# PostHog project API key (EU Cloud, D-179; Project settings > Project API key,
# starts with phc_). It's write-only, but keep it out of git all the same. Leave
# empty locally: analytics events are printed as JSON lines instead.
POSTHOG_API_KEY=
# Defaults to https://eu.i.posthog.com. Only set it to use another PostHog host.
# POSTHOG_HOST=

# --- Kasa Bot (worker, P-17, D-198) --------------------------------------------
# Which model answers @kasa. "stub" answers without any model or cost: use it for
# local development and CI. Otherwise a gateway model id with a price in
# apps/worker/src/bot/model.ts; the default is anthropic/claude-haiku-4.5.
KASA_BOT_MODEL=stub
# How long the stub takes to answer, so the thinking state shows (D-199). Default 1500.
# KASA_BOT_STUB_DELAY_MS=1500
# Vercel AI Gateway key from Petr's personal Vercel team (worker only, F-10). Without
# it, and without KASA_BOT_MODEL=stub, Kasa Bot is off: tags get a "couldn't answer" card.
AI_GATEWAY_API_KEY=

# --- Observability (OpenTelemetry, F-07, D-137) ------------------------------
# Traces and logs go over OTLP/HTTP to Kasa's own Dash0 org (D-136), never a
# work account. Leave the endpoint empty to keep telemetry local: logs still go
# to stdout as JSON, nothing is exported.
# Dash0: Settings > Endpoints > OTLP via HTTP, e.g. https://ingress.europe-west4.gcp.dash0.com
OTEL_EXPORTER_OTLP_ENDPOINT=
# Dash0 auth token (Settings > Auth Tokens, ingest only) and dataset. Comma-separated
# key=value pairs; the space after Bearer is written as %20. Every environment uses
# the `default` dataset and is told apart by deployment.environment.name (D-137).
# Dash0 accepts unknown dataset names with 200 and the data never shows up.
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20auth_xxx,Dash0-Dataset=default
OTEL_EXPORTER_OTLP_HEADERS=
# Tells environments apart: local, staging, production.
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local
# Don't set OTEL_SERVICE_NAME: each service names itself (kasa-web, kasa-worker,
# kasa-realtime) and the variable is ignored.
