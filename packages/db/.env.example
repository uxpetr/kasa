
# --- Realtime (P-06, D-103) ---------------------------------------------------
# Shared by the web app (signs tickets) and apps/realtime (verifies them).
# Any long random string, e.g. `openssl rand -base64 32`. Leave empty to run the
# feed without live updates.
REALTIME_SECRET=local-realtime-secret-change-me-0123456789
# WebSocket URL browsers connect to (web app).
REALTIME_PUBLIC_URL=ws://localhost:3200
# Port apps/realtime listens on.
REALTIME_PORT=3200
# Browser origins allowed to connect (apps/realtime), comma-separated.
# Defaults to BETTER_AUTH_URL.
REALTIME_ALLOWED_ORIGINS=
